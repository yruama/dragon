{
	"env": {
		"browser": true,
		"es2021": true
	},
	"extends": "standard-with-typescript",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"project": "./tsconfig.json"
	},
	"ignorePatterns": ["node_modules/", "**/node_modules/", "dist/", "build/", "**/dist/", "**/build/", "**/*.spec.ts"],
	"overrides": [
		{
			"files": ["**/*.ts"]
		}
	],
	"rules": {
		"indent": ["error", 4]
	}
}
