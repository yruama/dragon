// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "mysql"
  url           = env("DATABASE_URL")
}

model Pokemon {
  ID              Int           @id @default(autoincrement())
  POKEMON_ID      Int           @unique
  NAME            Json
  GENERATION      Int
  INFORMATIONS    Json
  STATISTICS      Json
  EVOLUTION       Int?          @default(-1)
  CREATED_AT      DateTime      @default(now())
  UPDATED_AT      DateTime      @updatedAt
  POKELISTDATA    PokelistData[] @relation("pokemonpokelistdataRelation")
}

model Informations {
  ID        Int     @id @default(autoincrement())
  HEIGHT    String
  CATEGORY  String
  WEIGHT    String
  TYPE      String
}

model Sprites {
  ID  Int     @id @default(autoincrement())
  URL String
}

model User {
  ID        Int     @id @default(autoincrement())
  LASTNAME  String
  FIRSTNAME String
  EMAIL     String
  PASSWORD  String
  USERNAME  String
  UUID      String
  POKELIST     Pokelist[]
  POKELISTDATA PokelistData[] @relation("userpokelistdataRelation")
}

model Generation {
  ID          Int     @id @default(autoincrement())
  NAME        String
  DESCRIPTION String
  MIN         Int     @default(0)
  MAX         Int     @default(1010)
}

model Pokelist {
  ID            Int         @id @default(autoincrement())
  NAME          String
  IMAGE         String
  USER          User        @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
  POKELISTDATA  PokelistData[]

  @@index([USER_ID])
}

model PokelistData {
  ID            Int       @id @default(autoincrement())
  POKEMON       Pokemon   @relation(fields: [POKEMON_ID], references: [POKEMON_ID], name: "pokemonpokelistdataRelation")
  POKEMON_ID    Int
  USER          User      @relation(fields: [USER_ID], references: [ID], name: "userpokelistdataRelation")
  USER_ID       Int
  POKELIST_ID   Int
  POKELIST      Pokelist  @relation(fields: [POKELIST_ID], references: [ID], onDelete: Cascade)
  OWNED         Int
  NOTE          String

  @@index([POKEMON_ID])
  @@index([USER_ID])
  @@index([POKELIST_ID])
}