// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "mysql"
  url           = env("DATABASE_URL")
  relationMode  = "prisma"
}

model Pokemon {
  ID              Int           @id @default(autoincrement())
  POKEMON_ID      Int           @unique
  NAME            Json
  GENERATION      Int
  INFORMATIONS    Json
  STATISTICS      Json
  EVOLUTION       Int?          @default(-1)
  CREATED_AT      DateTime      @default(now())
  UPDATED_AT      DateTime      @updatedAt
  POKELISTDATA    PokelistData[]
}

model Informations {
  ID        Int     @id @default(autoincrement())
  HEIGHT    String
  CATEGORY  String
  WEIGHT    String
  TYPE      String
}

model Sprites {
  ID  Int     @id @default(autoincrement())
  URL String
}

model User {
  ID        Int     @id @default(autoincrement())
  LASTNAME  String
  FIRSTNAME String
  EMAIL     String
  PASSWORD  String
  USERNAME  String
  UUID      String
  POKELIST     Pokelist[]
}

model Generation {
  ID          Int     @id @default(autoincrement())
  NAME        String
  DESCRIPTION String
  MIN         Int     @default(0)
  MAX         Int     @default(1010)
  POKELIST    Pokelist[]
}

model Pokelist {
  ID            Int         @id @default(autoincrement())
  NAME          String
  IMAGE         String
  GENERATION    Generation  @relation(fields: [GENERATION_ID], references: [ID])
  GENERATION_ID Int
  USER          User        @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
}

model PokelistData {
  ID            Int     @id @default(autoincrement())
  POKEMON       Pokemon @relation(fields: [POKEMON_ID], references: [POKEMON_ID])
  POKEMON_ID    Int
  USER_ID       Int
  POKELIST_ID   Int
  OWNED         Int
  NOTE          String
}