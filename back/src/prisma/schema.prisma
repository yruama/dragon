generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "mysql"
  url           = env("DATABASE_URL")
}

model POKEMON {
  ID              Int           @id @default(autoincrement())
  POKEMON_ID      Int           @unique
  NAME            Json
  GENERATION      Int
  INFORMATIONS    Json
  STATISTICS      Json
  EVOLUTION       Int?          @default(-1)
  CREATED_AT      DateTime      @default(now())
  UPDATED_AT      DateTime      @updatedAt
  POKELISTDATA    POKEMON_OWNED[]
}

model USER {
  ID        Int     @id @default(autoincrement())
  LASTNAME  String
  FIRSTNAME String
  EMAIL     String
  PASSWORD  String
  USERNAME  String
  UUID      String
  POKELIST     POKELIST[]
  POKELISTDATA POKEMON_OWNED[]
}

model GENERATION {
  ID            Int     @id @default(autoincrement())
  GENERATION_NO Int
  NAME          String
  DESCRIPTION   String
  MIN           Int     @default(0)
  MAX           Int     @default(1010)
}

model POKELIST {
  ID            Int         @id @default(autoincrement())
  NAME          String
  DESCRIPTION   String
  USER          USER        @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
  FILTER        String
  TOTAL         Int

  @@index([USER_ID])
}

model POKEMON_OWNED {
  ID            Int       @id @default(autoincrement())
  POKEMON       POKEMON   @relation(fields: [POKEMON_ID], references: [POKEMON_ID])
  POKEMON_ID    Int
  USER          USER      @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
  OWNED         Int
  NOTE          String

  @@index([POKEMON_ID])
  @@index([USER_ID])
}