generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider      = "mysql"
  url           = env("DATABASE_URL")
}

model POKEMON {
  ID              Int           @id @default(autoincrement())
  POKEMON_ID      Int           @unique
  NAME_FR         String
  NAME_EN         String
  DESCRIPTION_FR  String        @db.Text
  DESCRIPTION_EN  String        @db.Text
  CATEGORY        String
  TYPE_ID_1       Int
  TYPE_ID_2       Int
  TALENT          String
  SHAPE_ID        Int
  GENERATION      Int
  INFORMATIONS    Json
  EVOLUTION_ID    Int?       @default(-1)
  COLOR           String
  POKELISTDATA    POKEMON_OWNED[]
}


model EVOLUTION {
  ID                      Int     @id @default(autoincrement())
  GENDER                  Int?
  HELD_ITEM               String?
  ITEM                    String?
  KNOW_MOVE               String?
  KNOW_MOVE_TYPE          String?
  LOCATION                String?
  MIN_AFFECTION           Int?
  MIN_BEAUTY              Int?
  MIN_HAPPINESS           Int?
  MIN_LEVEL               Int?
  NEEDS_OVERWORLDS_RAIN   Int?
  PARTY_SPECIES           String?
  PARTY_TYPE              String?
  RELATIVE_PHYSICAL_STATS Int?
  TIME_OF_DAY             String?
  TRADE_SPECIES           String?
  TRIGGER                 String?
  POKEMON_ID              Int
  CHAIN_ID                Int
  LEVEL                   Int
}

model CATEGORY {
  ID        Int     @id @default(autoincrement())
  NAME_FR   String
  NAME_EN   String
}

model TALENT {
  ID              Int     @id @default(autoincrement())
  NAME_FR         String
  NAME_EN         String
  DESCRIPTION_FR  String  @db.Text
  DESCRIPTION_EN  String  @db.Text
}

model TYPE {
  ID        Int     @id @default(autoincrement())
  NAME      String

  @@fulltext([NAME])
}

model SHAPE {
  ID        Int     @id @default(autoincrement())
  NAME      String

  @@fulltext([NAME])
}

model USER {
  ID        Int     @id @default(autoincrement())
  LASTNAME  String
  FIRSTNAME String
  EMAIL     String
  PASSWORD  String
  USERNAME  String
  UUID      String
  POKELIST     POKELIST[]
  POKELISTDATA POKEMON_OWNED[]
}

model GENERATION {
  ID            Int     @id @default(autoincrement())
  GENERATION_NO Int
  NAME          String
  DESCRIPTION   String
  MIN           Int     @default(0)
  MAX           Int     @default(1010)
}

model POKELIST {
  ID            Int         @id @default(autoincrement())
  NAME          String
  DESCRIPTION   String
  USER          USER        @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
  FILTER        String
  TOTAL         Int

  @@index([USER_ID])
}

model POKEMON_OWNED {
  ID            Int       @id @default(autoincrement())
  POKEMON       POKEMON   @relation(fields: [POKEMON_ID], references: [POKEMON_ID])
  POKEMON_ID    Int
  USER          USER      @relation(fields: [USER_ID], references: [ID])
  USER_ID       Int
  OWNED         Int
  NOTE          String

  @@index([POKEMON_ID])
  @@index([USER_ID])
}